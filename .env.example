# Copy to .env for local development. NEVER commit .env.
# In production, set these in Render → Environment instead.

# Shopify (shopify app dev fills these in locally)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products

# Database (Postgres on Render; local dev can use a local Postgres or Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/hvac_ai"

# HVAC AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
PARTS_COLLECTION_HANDLE=parts
