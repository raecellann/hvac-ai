{%- liquid
  assign parts_handle = block.settings.parts_handle | default: 'parts'
  assign show = false
  assign product_handle = ''
  assign context_title = ''

  if template.name == 'collection'
    if collection.handle == parts_handle or block.settings.show_everywhere
      assign show = true
      assign context_title = collection.title
    endif
  elsif template.name == 'product'
    assign coll_handles = product.collections | map: 'handle'
    if coll_handles contains parts_handle or block.settings.show_everywhere
      assign show = true
      assign product_handle = product.handle
      assign context_title = product.title
    endif
  endif

  if request.design_mode
    assign show = true
  endif

  if routes.root_url == '/'
    assign proxy_base = ''
  else
    assign proxy_base = routes.root_url
  endif
-%}

{%- if show -%}
  {{ 'hvac-ai.css' | asset_url | stylesheet_tag }}
  <section
    class="hvac-ai"
    id="hvac-ai-{{ block.id }}"
    data-endpoint="{{ proxy_base }}/apps/hvac-ai/chat"
    data-product-handle="{{ product_handle | escape }}"
    data-collection-title="{{ context_title | escape }}"
    data-mode="{% if product_handle != blank %}product{% else %}collection{% endif %}"
    style="--hvac-ai-accent: {{ block.settings.accent }}; --hvac-ai-max: {{ block.settings.max_width }}px;"
    {{ block.shopify_attributes }}
  >
    <div class="hvac-ai__card">
      <header class="hvac-ai__header">
        <span class="hvac-ai__avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </span>
        <div>
          <h2 class="hvac-ai__title">{{ block.settings.heading | escape }}</h2>
          <p class="hvac-ai__subtitle">
            {%- if product_handle != blank -%}
              {{ block.settings.product_intro | escape }}
            {%- else -%}
              {{ block.settings.collection_intro | escape }}
            {%- endif -%}
          </p>
        </div>
      </header>

      <div class="hvac-ai__log" role="log" aria-live="polite" aria-label="HVAC AI conversation"></div>

      <div class="hvac-ai__suggestions">
        {%- if product_handle != blank -%}
          {%- assign suggestions = block.settings.product_suggestions | newline_to_br | split: '<br />' -%}
        {%- else -%}
          {%- assign suggestions = block.settings.collection_suggestions | newline_to_br | split: '<br />' -%}
        {%- endif -%}
        {%- for s in suggestions -%}
          {%- assign s_clean = s | strip -%}
          {%- if s_clean != blank -%}
            <button type="button" class="hvac-ai__suggestion">{{ s_clean | escape }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <form class="hvac-ai__form" novalidate>
        <label class="visually-hidden" for="hvac-ai-input-{{ block.id }}">Ask HVAC AI</label>
        <textarea
          id="hvac-ai-input-{{ block.id }}"
          class="hvac-ai__input"
          rows="1"
          maxlength="1500"
          placeholder="{{ 'hvac_ai.placeholder' | t }}"
        ></textarea>
        <button type="submit" class="hvac-ai__send" aria-label="Send">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
      <p class="hvac-ai__disclaimer">{{ block.settings.disclaimer | escape }}</p>
    </div>
  </section>
  <script src="{{ 'hvac-ai.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "HVAC AI Parts Assistant",
  "target": "section",
  "enabled_on": { "templates": ["collection", "product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "HVAC AI" },
    { "type": "text", "id": "collection_intro", "label": "Intro (collection page)", "default": "Describe the symptom or a meter reading and I'll help pinpoint the failed part." },
    { "type": "text", "id": "product_intro", "label": "Intro (product page)", "default": "Ask how to test this part, what failure looks like, or whether it fits your unit." },
    { "type": "textarea", "id": "collection_suggestions", "label": "Suggested questions (collection, one per line)", "default": "Furnace gas valve will not come on\nAC contactor is buzzing but the condenser won't start\nInducer runs, igniter glows, then shuts down" },
    { "type": "textarea", "id": "product_suggestions", "label": "Suggested questions (product, one per line)", "default": "How do I test this part?\nWhat are the signs this part has failed?\nWill this fit my unit?" },
    { "type": "text", "id": "parts_handle", "label": "Parts collection handle", "default": "parts", "info": "The assistant only appears on this collection and on products in it." },
    { "type": "checkbox", "id": "show_everywhere", "label": "Show on every page this block is added to", "default": false, "info": "Use if products don't list the Parts collection in Liquid. Answers stay limited to parts either way." },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#1D5FD1" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 600, "max": 1400, "step": 50, "unit": "px", "default": 900 },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "AI guidance for trained technicians. Gas and refrigerant work should be done by a licensed pro." }
  ]
}
{% endschema %}
